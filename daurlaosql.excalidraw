    {
      "id": "fQfQapG6goRjORxYoVMGD",
      "type": "text",
      "x": -15397.063832502026,
      "y": 17.326780801511177,
      "width": 746.039306640625,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
