    {
      "id": "2XJnZajShiEYSzRXq10Rn",
      "type": "text",
      "x": -16003.237585610128,
      "y": -904.4694172238171,
      "width": 219.33978271484375,
      "height": 175,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
