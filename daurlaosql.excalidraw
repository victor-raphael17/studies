      "seed": 1513259841,
      "version": 811,
      "versionNonce": 1667278345,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790771361443,
      "created": 1790106409661,
      "link": null,
      "locked": false,
      "text": "É assim que o pacote\nsai do computador,\nmas ele ainda precisa\npassar pelo roteador.\nUma das principais\nfunções do roteador é\nconfigurar o NAT.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "fg-8NZ5t6RY6ifJVX1VZm",
      "originalText": "É assim que o pacote sai do computador, mas ele ainda precisa passar pelo roteador. Uma das principais funções do roteador é configurar o NAT.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": 0.5
    },
    {
      "id": "G0Jalbh0xeNYhAksmmKry",
      "type": "text",
      "x": -15617.390710281172,
      "y": -483.4821854623314,
      "width": 757.3192749023438,
      "height": 75,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "KztuXi7kgnO7rTGGg754q"
      ],
      "frameId": null,
      "index": "bcR",
      "roundness": null,
      "seed": 574594017,
      "version": 2227,
      "versionNonce": 508624105,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "jtYYmrzJqNG80AHhIEDvl",
          "type": "arrow"
        }
      ],
      "updated": 1790771361443,
      "created": 1790106523077,
      "link": null,
      "locked": false,
      "text": "Repare que o Source Address ainda é um endereço IP interno, ou seja,\nservidores e computadores externos (que não estão na mesma wifi/rede local)\nnão podem enviar nenhum pacote IP para ele",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Repare que o Source Address ainda é um endereço IP interno, ou seja,\nservidores e computadores externos (que não estão na mesma wifi/rede local)\nnão podem enviar nenhum pacote IP para ele",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
